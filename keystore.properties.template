# Copy this file to keystore.properties and fill in your values.
# keystore.properties is git-ignored and must NEVER be committed.
#
# Generate a keystore once with:
#   keytool -genkeypair -v -keystore reader-release.keystore -alias reader ^
#     -keyalg RSA -keysize 4096 -validity 10000
#
# storeFile is resolved relative to the project root (absolute paths work too).
storeFile=reader-release.keystore
storePassword=CHANGE_ME
keyAlias=reader
keyPassword=CHANGE_ME
